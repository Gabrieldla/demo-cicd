{
  "name": "demo-cicd",
  "version": "1.0.0",
  "private": true,
  "description": "Repositorio base del LAB-04 (IF-1116, Semana 06): una app de tres servicios lista para que le construyas su pipeline CI/CD",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:html",
